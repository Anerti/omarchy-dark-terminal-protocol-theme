#!/usr/bin/env python3

# Build logo/vaulttec-omarchy.svg: the Vault-Tec wings with the Omarchy square mark in
# place of the roundel. Without an out path it also refreshes unlock.png (Omarchy's built-in
# lock screen emblem), and, when TERMINAL_PROTOCOL_CONTROLLER_DIR names a checkout of the
# Terminal Protocol Controller, the copies its plugins ship, which would otherwise go stale:
# the lock screen's and the menu's (white, tinted at runtime) and the workspaces wedge's ink
# version. That needs rsvg-convert and magick.
# Usage: [TERMINAL_PROTOCOL_CONTROLLER_DIR=...] tools/build-logo [stroke] [gap] [out] [fill]
#        (default: 0 16 logo/vaulttec-omarchy.svg #2cae2e)

import subprocess
import sys
W, H, CX, CY = 930.07, 360.0, 465.03, 180.0
MARK = "M0 0h300v20h-300ZM0 0h20v300h-20ZM280 0h20v300h-20ZM0 280h160v20h-160ZM180 280h120v20h-120ZM40 40h120v20h-120ZM220 40h40v20h-40ZM40 40h20v220h-20ZM240 40h20v220h-20ZM40 240h220v20h-220ZM140 0h20v60h-20ZM0 140h60v20h-60ZM140 240h20v60h-20Z"
MW, MH = 300.0, 300.0

def svg(stroke, gap, fill="#2cae2e"):
    s = H / (MH + stroke)
    left = CX - (MW + stroke) * s / 2
    tx, ty = left + stroke / 2 * s, CY - H / 2 + stroke / 2 * s
    e, r = left - gap, W - (left - gap)
    f = lambda v: f"{v:.2f}".rstrip("0").rstrip(".")
    wings = [
        f"M212.3,120.05c-6.24,0-37.05-1.18-52.24-23.77l-1.97-2.92,1.97-2.92c15.19-22.59,46.01-23.77,52.24-23.77H{f(e)}V120.05Z",
        f"M{f(e)},153.3H54.22c-6.24,0-37.04,1.18-52.24,23.77l-1.97,2.92,1.97,2.92c15.21,22.59,46.01,23.77,52.24,23.77H{f(e)}Z",
        f"M212.3,239.95c-6.24,0-37.05,1.18-52.24,23.77l-1.97,2.92,1.97,2.92c15.19,22.59,46.01,23.77,52.24,23.77H{f(e)}V239.95Z",
        f"M717.77,120.05c6.24,0,37.05-1.18,52.24-23.77l1.97-2.92-1.97-2.92c-15.19-22.59-46.01-23.77-52.24-23.77H{f(r)}V120.05Z",
        f"M{f(r)},153.3H875.85c6.24,0,37.04,1.18,52.24,23.77l1.97,2.92-1.97,2.92c-15.21,22.59-46.01,23.77-52.24,23.77H{f(r)}Z",
        f"M717.77,239.95c6.24,0,37.05,1.18,52.24,23.77l1.97,2.92-1.97,2.92c-15.19,22.59-46.01,23.77-52.24,23.77H{f(r)}V239.95Z",
    ]
    stroke_attr = f' stroke="{fill}" stroke-width="{f(stroke)}" stroke-linejoin="miter"' if stroke else ""
    return f'''<?xml version="1.0" encoding="UTF-8"?>
<!-- Vault-Tec wings around the Omarchy square mark (in place of the roundel).
     Generated: mark traced from the opaque cells of /usr/share/omarchy/icon.png (15x15 grid of 20-unit cells), scaled to the
     roundel's 360-unit height, stroked {f(stroke)} units heavier; wings end {f(gap)} units short of it. -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}">
  <g id="Wings" fill="{fill}">
{chr(10).join(f'    <path d="{d}"/>' for d in wings)}
  </g>
  <g id="OmarchyMark" fill="{fill}"{stroke_attr} transform="translate({f(tx)},{f(ty)}) scale({s:.4f})">
    <path d="{MARK}"/>
  </g>
</svg>
'''

if __name__ == "__main__":
    import os
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    args = sys.argv[1:]
    stroke = float(args[0]) if len(args) > 0 else 0
    gap = float(args[1]) if len(args) > 1 else 16
    out = args[2] if len(args) > 2 else os.path.join(root, "logo", "vaulttec-omarchy.svg")
    fill = args[3] if len(args) > 3 else "#2cae2e"
    with open(out, "w") as f:
        f.write(svg(stroke, gap, fill))
    print(out)

    if len(args) <= 2:
        controller = os.environ.get("TERMINAL_PROTOCOL_CONTROLLER_DIR")
        copies = [
            (os.path.join(controller, "plugins", "anerti.lock", "assets", "vaulttec-omarchy.svg"), "#ffffff"),
            (os.path.join(controller, "plugins", "anerti.menu", "assets", "vaulttec-omarchy.svg"), "#ffffff"),
            (os.path.join(controller, "plugins", "anerti.workspaces", "assets", "vaulttec-omarchy-ink.svg"), "#000000"),
        ] if controller else []
        for path, colour in copies:
            with open(path, "w") as f:
                f.write(svg(stroke, gap, colour))
            print(path)
        # unlock.png: the logo 188px tall, centred on an 800x188 transparent canvas.
        unlock = os.path.join(root, "unlock.png")
        png = subprocess.run(["rsvg-convert", "-h", "188", out], check=True, capture_output=True).stdout
        subprocess.run(["magick", "png:-", "-background", "none", "-gravity", "center",
                        "-extent", "800x188", "PNG32:" + unlock], input=png, check=True)
        print(unlock)
