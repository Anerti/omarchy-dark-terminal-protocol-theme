#!/usr/bin/env python3

# Build backgrounds/3-omarchy-wordmark.jpg: the Fallout 4 title card (a slanted, rounded
# badge whose frame and letters are cut out of black to show scenes from the game, flecked
# with chipped paint) redone with Omarchy's brand wordmark (logo/omarchy-wordmark.svg, from
# omarchy.org/brand) and Omarchy's own theme wallpapers as the scenes, one per letter.
# Everything is brought down to the theme's black and green, as in 2-welcome-home.jpg.
# The flecks and the background grain come from a fixed seed, so rebuilds are identical.
# --colour keeps the scenes' own colours on plain black, as on the Fallout 4 card, and
# --no-badge leaves out the frame; either writes to [out] instead of the theme's wallpaper.
# Needs rsvg-convert, magick and the wallpapers under /usr/share/omarchy/themes.
# Usage: tools/build-wallpaper-wordmark [--colour] [--no-badge] [out]

import math
import random
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "backgrounds/3-omarchy-wordmark.jpg"
WORDMARK = ROOT / "logo/omarchy-wordmark.svg"
THEMES = Path("/usr/share/omarchy/themes")

W, H = 3840, 2160
CX, CY = W / 2, H / 2
BG = "#06170d"
# Shadows to highlights of the scenes, from a green deep enough to stay apart from the
# background (so the letters keep their shape where a scene is dark) up to light_foreground.
RAMP = ["#0d3814", "#1f7a20", "#2cae2e", "#6bc66d"]
SLANT = math.tan(math.radians(14))  # the badge's lean, as in the Fallout 4 card

# The badge before it is slanted, and the wordmark inside it.
BADGE_W, BADGE_H, BADGE_R, BADGE_LINE = 3360, 1060, 80, 30
MARK_W = 3080

# One scene per letter, with where to centre the crop across the picture (0 left, 1 right).
SCENES = [
    ("tokyo-night/backgrounds/1-quattro.jpg", 0.42),
    ("tokyo-night/backgrounds/5-oma-cityscape.jpg", 0.5),
    ("osaka-jade/backgrounds/1-glowing-city.jpg", 0.55),
    ("kanagawa/backgrounds/1-kanagawa.jpg", 0.62),
    ("matte-black/backgrounds/0-ship-at-sea.jpg", 0.52),
    ("retro-82/backgrounds/4-gateway.jpg", 0.47),
    ("retro-82/backgrounds/2-dusk-guardian.jpg", 0.47),
]


def slant(x, y):
    """Lean a point right above the centre line and left below it."""
    return x + SLANT * (CY - y), y


def letters(rects):
    """Split the wordmark's columns into letters at the empty columns between them.
    The c and h touch, so they are split where the column ink is thinnest between them."""
    ink = {}
    for x, y, w, h in rects:
        for c in range(x, x + w):
            ink[c] = ink.get(c, 0) + h
    cols = sorted(ink)
    runs, start = [], cols[0]
    for a, b in zip(cols, cols[1:]):
        if b != a + 1:
            runs.append((start, a + 1))
            start = b
    runs.append((start, cols[-1] + 1))
    cuts = [(a[1] + b[0]) / 2 for a, b in zip(runs, runs[1:])]
    a, b = next(r for r in runs if r[1] - r[0] > 800 and r[0] > 2000)
    mid = (a + b) / 2
    cuts.append(min(range(int(mid) - 150, int(mid) + 150), key=lambda c: ink.get(c, 0)) + 0.5)
    return sorted(cuts)


def fleck(rng, x, y):
    """A chip of paint: a lumpy, sometimes stretched blob, mostly small."""
    r = min(1.5 + rng.paretovariate(2.5) * 2.2, 10)
    stretch, turn = rng.uniform(1, 1.8), rng.uniform(0, math.pi)
    pts = []
    for i in range(9):
        a = i * 2 * math.pi / 9 + rng.uniform(-0.25, 0.25)
        d = r * rng.uniform(0.55, 1.1)
        px, py = math.cos(a) * d * stretch, math.sin(a) * d
        pts.append((x + px * math.cos(turn) - py * math.sin(turn), y + px * math.sin(turn) + py * math.cos(turn)))
    return "M" + "L".join(f"{px:.1f},{py:.1f}" for px, py in pts) + "Z"


def main():
    args = sys.argv[1:]
    colour, badge = "--colour" in args, "--no-badge" not in args
    paths = [a for a in args if not a.startswith("--")]
    if len(paths) > 1 or set(args) - {"--colour", "--no-badge", *paths}:
        sys.exit("Usage: tools/build-wallpaper-wordmark [--colour] [--no-badge] [out]")
    out = Path(paths[0]) if paths else OUT
    bg = "#000000" if colour else BG

    rects =[tuple(map(int, m)) for m in re.findall(
        r'x="(\d+)" y="(\d+)" width="(\d+)" height="(\d+)"', WORDMARK.read_text())]
    vw, vh = map(float, re.search(r'viewBox="0 0 ([\d.]+) ([\d.]+)"', WORDMARK.read_text()).groups())
    s = MARK_W / vw
    mx, my = CX - MARK_W / 2, CY - vh * s / 2
    bx, by = CX - BADGE_W / 2, CY - BADGE_H / 2
    # Without the badge, the scenes only need to cover the letters.
    top, bottom = (by - BADGE_LINE, by + BADGE_H + BADGE_LINE) if badge else (my - 10, my + vh * s + 10)

    # Strip edges in the unslanted badge: the outer two run past the frame.
    edges = [bx - 2 * BADGE_LINE] + [mx + c * s for c in letters(rects)] + [bx + BADGE_W + 2 * BADGE_LINE]
    lean = f"translate(0,{CY}) matrix(1,0,{-SLANT},1,0,0) translate(0,{-CY})"

    rng = random.Random(25448)
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        clut = tmp / "ramp.png"
        subprocess.run(["magick", *[f"xc:{c}" for c in RAMP], "+append", "-filter", "triangle",
                        "-resize", "256x1!", str(clut)], check=True)

        clips, images = [], []
        for i, ((scene, fx), (a, b)) in enumerate(zip(SCENES, zip(edges, edges[1:]))):
            quad = [slant(a, top), slant(b, top), slant(b, bottom), slant(a, bottom)]
            x0, x1 = min(p[0] for p in quad), max(p[0] for p in quad)
            w, h = math.ceil(x1 - x0), math.ceil(bottom - top)
            png = tmp / f"scene{i}.png"
            # Cover the strip's box at the scene's own aspect, crop around fx, then map its
            # brightness onto the green ramp (or, in colour, just lift it off the black a little,
            # so the letters keep their shape where a scene is dark).
            src = THEMES / scene
            sw, sh = map(int, subprocess.run(["magick", "identify", "-format", "%w %h", str(src)],
                                             check=True, capture_output=True, text=True).stdout.split())
            k = max(w / sw, h / sh)
            rw, rh = math.ceil(sw * k), math.ceil(sh * k)
            ox = min(max(round(rw * fx - w / 2), 0), rw - w)
            tone = (["+level", "7%,100%"] if colour else
                    ["-colorspace", "Gray", "-auto-level", "-sigmoidal-contrast", "4x45%",
                     "-colorspace", "sRGB", str(clut), "-clut"])
            subprocess.run(["magick", str(src), "-resize", f"{rw}x{rh}!", "-crop", f"{w}x{h}+{ox}+{(rh - h) // 2}",
                            "+repage", *tone, str(png)], check=True)
            pts = " ".join(f"{px:.1f},{py:.1f}" for px, py in quad)
            clips.append(f'<clipPath id="s{i}"><polygon points="{pts}"/></clipPath>')
            images.append(f'<image href="{png}" x="{x0:.1f}" y="{top}" width="{w}" height="{h}" '
                          f'preserveAspectRatio="none" clip-path="url(#s{i})"/>')

        # As many flecks per area of the badge, which is all they show on.
        flecks = []
        for _ in range(round(1300 * (bottom - top) / (BADGE_H + 2 * BADGE_LINE))):
            x, y = rng.uniform(bx - 60, bx + BADGE_W + 60), rng.uniform(top - 10, bottom + 10)
            flecks.append(fleck(rng, *slant(x, y)))

        # Faint scratches on the background, as on the Welcome Home poster.
        scratches = []
        for _ in range(260):
            x, y = rng.uniform(0, W), rng.uniform(0, H)
            a, n = rng.uniform(0, 2 * math.pi), rng.uniform(15, 70)
            bend = rng.uniform(-0.4, 0.4)
            ex, ey = x + math.cos(a) * n, y + math.sin(a) * n
            qx, qy = (x + ex) / 2 - math.sin(a) * n * bend, (y + ey) / 2 + math.cos(a) * n * bend
            scratches.append(f"M{x:.0f},{y:.0f}Q{qx:.0f},{qy:.0f} {ex:.0f},{ey:.0f}")

        # One path, not one rect per cell: separately anti-aliased cells leave hairline seams
        # between rows once slanted.
        mark = "".join(f"M{x},{y}h{w}v{h}h{-w}Z" for x, y, w, h in rects)
        frame = (f'<rect x="{bx}" y="{by}" width="{BADGE_W}" height="{BADGE_H}" rx="{BADGE_R}" '
                 f'fill="none" stroke="#fff" stroke-width="{BADGE_LINE}"/>') if badge else ""
        # The scratches and the grain are the green poster's print texture; the colour card
        # is clean black.
        texture = "" if colour else (f'<path d="{"".join(scratches)}" fill="none" stroke="#1f7a20" '
                                     'stroke-opacity="0.22" stroke-width="1.6" stroke-linecap="round"/>')
        svg = f'''<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">
<defs>
  {"".join(clips)}
  <mask id="cut" maskUnits="userSpaceOnUse" x="0" y="0" width="{W}" height="{H}">
    <g transform="{lean}">
      {frame}
      <path fill="#fff" transform="translate({mx:.2f},{my:.2f}) scale({s:.5f})" d="{mark}"/>
    </g>
  </mask>
</defs>
<rect width="{W}" height="{H}" fill="{bg}"/>
{texture}
<g mask="url(#cut)">
  {"".join(images)}
  <path d="{"".join(flecks)}" fill="{bg}"/>
</g>
</svg>'''
        (tmp / "card.svg").write_text(svg)
        subprocess.run(["rsvg-convert", str(tmp / "card.svg"), "-o", str(tmp / "card.png")], check=True)
        # Film grain: sparse green specks over everything, like the poster's print texture.
        grain = [] if colour else [
            "(", "-size", f"{W}x{H}", "xc:gray50", "-seed", "25448", "-attenuate", "1.2",
            "+noise", "Gaussian", "-colorspace", "Gray", "-level", "62%,100%",
            "-fill", "#1f7a20", "-tint", "100", "-evaluate", "multiply", "0.18", ")",
            "-compose", "plus", "-composite"]
        subprocess.run(["magick", str(tmp / "card.png"), *grain, "-quality", "92", str(out)], check=True)
    print(out)


if __name__ == "__main__":
    main()
